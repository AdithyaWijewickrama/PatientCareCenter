<BorderPane minHeight="474.0" minWidth="352.0" prefHeight="561.0" prefWidth="605.0" stylesheets="@../../../Styles/globals.css" xmlns="http://javafx.com/javafx/23.0.1" xmlns:fx="http://javafx.com/fxml/1">
<!--            fx:controller="com.pcc.PatientCareCenter.Controllers.Admin.PharmacyStock.MedicineSelectorController">-->
   <top>
      <VBox BorderPane.alignment="CENTER">
         <children>
            <FlowPane alignment="CENTER_LEFT" columnHalignment="RIGHT" prefHeight="50.0" prefWidth="713.0">
               <children>
                  <FontAwesomeIconView glyphName="EDIT" size="30" styleClass="normal-text-p" wrappingWidth="34.0">
                     <FlowPane.margin>
                        <Insets bottom="10.0" left="10.0" right="10.0" top="10.0" />
                     </FlowPane.margin>
                  </FontAwesomeIconView>
                  <VBox alignment="CENTER_LEFT" prefHeight="54.0" prefWidth="227.0">
                     <children>
                        <Label fx:id="pharmacyStock" contentDisplay="RIGHT" prefHeight="35.0" prefWidth="209.0" styleClass="h2-p" text="Select medicines" textOverrun="LEADING_ELLIPSIS" />
                     </children>
                  </VBox>
               </children>
            </FlowPane>
            <BorderPane prefHeight="13.0" prefWidth="761.0">
               <top>
                  <AnchorPane prefHeight="70.0" prefWidth="905.0" BorderPane.alignment="CENTER">
                     <children>
                        <TextField fx:id="searchTextField" layoutX="14.0" layoutY="13.0" prefHeight="36.0" prefWidth="436.0" promptText="Search in pharmacy stock" styleClass="textfield" />
                     </children>
                  </AnchorPane>
               </top>
            </BorderPane>
         </children>
      </VBox>
   </top>
   <center>
      <ScrollPane fitToHeight="true" fitToWidth="true" prefHeight="448.0" prefWidth="693.0" BorderPane.alignment="CENTER">
         <content>
            <BorderPane prefHeight="200.0" prefWidth="200.0">
               <center>
                  <TableView fx:id="tableView" prefHeight="402.0" prefWidth="742.0" stylesheets="@../../../Styles/Admin/stock.css" BorderPane.alignment="CENTER">
                     <BorderPane.margin>
                        <Insets />
                     </BorderPane.margin>
                  </TableView>
               </center>
            </BorderPane>
         </content>
         <BorderPane.margin>
            <Insets bottom="10.0" left="10.0" right="10.0" top="10.0" />
         </BorderPane.margin>
      </ScrollPane>
   </center>
   <bottom>
      <HBox alignment="BOTTOM_CENTER" prefHeight="73.0" prefWidth="605.0" BorderPane.alignment="CENTER">
         <children>
            <Label fx:id="message" prefHeight="51.0" prefWidth="327.0" visible="false" wrapText="true">
               <HBox.margin>
                  <Insets bottom="10.0" left="10.0" right="10.0" top="10.0" />
               </HBox.margin>
            </Label>
            <VBox alignment="CENTER_RIGHT" prefHeight="100.0" prefWidth="232.0">
               <children>
                  <Button fx:id="add" mnemonicParsing="false" styleClass="button-primary" text="Add">
                     <graphic>
                        <FontAwesomeIconView fill="WHITE" glyphName="PLUS" />
                     </graphic>
                     <VBox.margin>
                        <Insets bottom="5.0" left="5.0" right="10.0" top="5.0" />
                     </VBox.margin>
                  </Button>
               </children>
            </VBox>
         </children>
      </HBox>
   </bottom>
