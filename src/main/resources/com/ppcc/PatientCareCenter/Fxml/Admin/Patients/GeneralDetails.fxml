<?xml version="1.0" encoding="UTF-8"?>

<?import javafx.geometry.Insets?>
<?import javafx.scene.control.Accordion?>
<?import javafx.scene.control.Button?>
<?import javafx.scene.control.ComboBox?>
<?import javafx.scene.control.DatePicker?>
<?import javafx.scene.control.Label?>
<?import javafx.scene.control.RadioButton?>
<?import javafx.scene.control.TextField?>
<?import javafx.scene.control.TitledPane?>
<?import javafx.scene.control.ToggleGroup?>
<?import javafx.scene.layout.BorderPane?>
<?import javafx.scene.layout.FlowPane?>
<?import javafx.scene.layout.HBox?>
<?import javafx.scene.layout.VBox?>


<BorderPane maxHeight="-Infinity"
            maxWidth="-Infinity"
            minHeight="-Infinity"
            minWidth="-Infinity"
            prefHeight="545.0"
            prefWidth="462.0"
            stylesheets="@../../../Styles/globals.css"
            xmlns="http://javafx.com/javafx/23.0.1"
            xmlns:fx="http://javafx.com/fxml/1">
   <top>
      <VBox alignment="TOP_CENTER" prefHeight="39.0" prefWidth="442.0" BorderPane.alignment="CENTER">
         <BorderPane.margin>
            <Insets bottom="10.0" left="10.0" right="10.0" top="10.0"/>
         </BorderPane.margin>
         <children>
            <Label alignment="CENTER" prefHeight="35.0" prefWidth="250.0" styleClass="h2-p" text="General Details"/>
         </children>
      </VBox>
   </top>
   <bottom>
      <FlowPane alignment="CENTER" prefHeight="44.0" prefWidth="462.0" BorderPane.alignment="CENTER">
         <children>
            <Button mnemonicParsing="false" styleClass="button-primary" text="Save"/>
         </children>
      </FlowPane>
   </bottom>
   <center>
      <Accordion BorderPane.alignment="CENTER">
         <panes>
            <TitledPane animated="false" text="Patient demographics">
               <content>
                  <VBox prefHeight="200.0" prefWidth="100.0">
                     <opaqueInsets>
                        <Insets bottom="10.0" left="10.0" right="10.0" top="10.0"/>
                     </opaqueInsets>
                     <children>
                        <Label styleClass="normal-text-p" text="Name"/>
                        <TextField fx:id="name" promptText="Enter name" styleClass="textfield">
                           <VBox.margin>
                              <Insets top="5.0"/>
                           </VBox.margin>
                        </TextField>
                        <Label styleClass="normal-text-p" text="Date of birth">
                           <VBox.margin>
                              <Insets bottom="5.0" top="10.0"/>
                           </VBox.margin>
                        </Label>
                        <DatePicker fx:id="dateOfBirth" prefHeight="25.0" prefWidth="185.0" promptText="Date of birth"
                                    styleClass="textfield"/>
                        <Label styleClass="normal-text-p" text="Gender">
                           <VBox.margin>
                              <Insets top="10.0"/>
                           </VBox.margin>
                        </Label>
                        <HBox prefHeight="29.0" prefWidth="400.0">
                           <children>
                              <RadioButton fx:id="male" mnemonicParsing="false" selected="true"
                                           styleClass="normal-text-p" text="Male">
                                 <HBox.margin>
                                    <Insets bottom="5.0" left="5.0" right="5.0" top="5.0"/>
                                 </HBox.margin>
                                 <toggleGroup>
                                    <ToggleGroup fx:id="genderGroup"/>
                                 </toggleGroup>
                              </RadioButton>
                              <RadioButton fx:id="feemale" mnemonicParsing="false" styleClass="normal-text-p"
                                           text="Female" toggleGroup="$genderGroup">
                                 <HBox.margin>
                                    <Insets bottom="5.0" left="5.0" right="5.0" top="5.0"/>
                                 </HBox.margin>
                              </RadioButton>
                              <RadioButton fx:id="other" mnemonicParsing="false" styleClass="normal-text-p" text="Other"
                                           toggleGroup="$genderGroup">
                                 <HBox.margin>
                                    <Insets bottom="5.0" left="5.0" right="5.0" top="5.0"/>
                                 </HBox.margin>
                              </RadioButton>
                           </children>
                        </HBox>
                        <Label styleClass="normal-text-p" text="Marital status">
                           <VBox.margin>
                              <Insets bottom="5.0" top="10.0"/>
                           </VBox.margin>
                        </Label>
                        <HBox prefHeight="29.0" prefWidth="400.0">
                           <children>
                              <RadioButton fx:id="unmaried" mnemonicParsing="false" selected="true"
                                           styleClass="normal-text-p" text="Unmarried">
                                 <HBox.margin>
                                    <Insets bottom="5.0" left="5.0" right="5.0" top="5.0"/>
                                 </HBox.margin>
                                 <toggleGroup>
                                    <ToggleGroup fx:id="genderGroup1"/>
                                 </toggleGroup>
                              </RadioButton>
                              <RadioButton fx:id="married" mnemonicParsing="false" styleClass="normal-text-p"
                                           text="Married" toggleGroup="$genderGroup1">
                                 <HBox.margin>
                                    <Insets bottom="5.0" left="5.0" right="5.0" top="5.0"/>
                                 </HBox.margin>
                              </RadioButton>
                              <RadioButton fx:id="devoreced" mnemonicParsing="false" styleClass="normal-text-p"
                                           text="Devoreced" toggleGroup="$genderGroup1">
                                 <HBox.margin>
                                    <Insets bottom="5.0" left="5.0" right="5.0" top="5.0"/>
                                 </HBox.margin>
                              </RadioButton>
                           </children>
                        </HBox>
                        <Label styleClass="normal-text-p" text="Nationality">
                           <VBox.margin>
                              <Insets bottom="5.0" top="10.0"/>
                           </VBox.margin>
                        </Label>
                        <ComboBox fx:id="city1" prefHeight="27.0" prefWidth="187.0" promptText="Select nationality"
                                  styleClass="textfield"/>
                        <Label styleClass="normal-text-p" text="Language preference">
                           <VBox.margin>
                              <Insets bottom="5.0" top="10.0"/>
                           </VBox.margin>
                        </Label>
                        <ComboBox fx:id="city2" prefHeight="27.0" prefWidth="187.0" promptText="Select language"
                                  styleClass="textfield"/>
                     </children>
                     <padding>
                        <Insets bottom="10.0" left="10.0" right="10.0" top="10.0"/>
                     </padding>
                  </VBox>
               </content>
            </TitledPane>
            <TitledPane animated="false" text="Contact details">
               <content>
                  <VBox prefHeight="200.0" prefWidth="100.0">
                     <children>
                        <Label styleClass="normal-text-p" text="Street Address">
                           <VBox.margin>
                              <Insets bottom="5.0" top="10.0"/>
                           </VBox.margin>
                        </Label>
                        <TextField fx:id="streetAddress" promptText="Enter stret address" styleClass="textfield"/>
                        <HBox prefHeight="47.0" prefWidth="400.0">
                           <children>
                              <VBox prefHeight="58.0" prefWidth="400.0">
                                 <children>
                                    <Label styleClass="normal-text-p" text="Mobile Number">
                                       <VBox.margin>
                                          <Insets bottom="5.0" top="10.0"/>
                                       </VBox.margin>
                                    </Label>
                                    <TextField fx:id="mobileNumber" prefHeight="27.0" prefWidth="177.0"
                                               promptText="Enter mobile number" styleClass="textfield"/>
                                 </children>
                                 <HBox.margin>
                                    <Insets right="5.0"/>
                                 </HBox.margin>
                              </VBox>
                              <VBox prefHeight="58.0" prefWidth="400.0">
                                 <children>
                                    <Label styleClass="normal-text-p" text="Whatsapp number">
                                       <VBox.margin>
                                          <Insets bottom="5.0" top="10.0"/>
                                       </VBox.margin>
                                    </Label>
                                    <TextField fx:id="whatsappNumber" prefHeight="27.0" prefWidth="177.0"
                                               promptText="Enter whatsapp number" styleClass="textfield"/>
                                 </children>
                                 <HBox.margin>
                                    <Insets left="5.0"/>
                                 </HBox.margin>
                              </VBox>
                           </children>
                        </HBox>
                        <VBox prefHeight="61.0" prefWidth="403.0">
                           <children>
                              <Label styleClass="normal-text-p" text="Lan number">
                                 <VBox.margin>
                                    <Insets bottom="5.0" top="10.0"/>
                                 </VBox.margin>
                              </Label>
                              <TextField fx:id="lanNumber" prefHeight="27.0" prefWidth="393.0"
                                         promptText="Enter lan number" styleClass="textfield">
                                 <VBox.margin>
                                    <Insets right="205.0"/>
                                 </VBox.margin>
                              </TextField>
                           </children>
                        </VBox>
                        <Label styleClass="normal-text-p" text="Country">
                           <VBox.margin>
                              <Insets bottom="5.0" top="10.0"/>
                           </VBox.margin>
                        </Label>
                        <ComboBox fx:id="country" prefHeight="27.0" prefWidth="418.0" styleClass="textfield"/>
                        <HBox prefHeight="58.0" prefWidth="400.0">
                           <children>
                              <VBox prefHeight="58.0" prefWidth="198.0">
                                 <children>
                                    <Label styleClass="normal-text-p" text="City">
                                       <VBox.margin>
                                          <Insets bottom="5.0" top="10.0"/>
                                       </VBox.margin>
                                    </Label>
                                    <ComboBox fx:id="city" prefHeight="27.0" prefWidth="187.0" promptText="Select city"
                                              styleClass="textfield"/>
                                 </children>
                              </VBox>
                              <VBox prefHeight="58.0" prefWidth="203.0">
                                 <children>
                                    <Label styleClass="normal-text-p" text="Province">
                                       <VBox.margin>
                                          <Insets bottom="5.0" top="10.0"/>
                                       </VBox.margin>
                                    </Label>
                                    <ComboBox fx:id="province" prefHeight="27.0" prefWidth="226.0"
                                              promptText="Select contry" styleClass="textfield"/>
                                 </children>
                              </VBox>
                           </children>
                        </HBox>
                        <Label styleClass="normal-text-p" text="Postal code">
                           <VBox.margin>
                              <Insets bottom="5.0" top="10.0"/>
                           </VBox.margin>
                        </Label>
                        <TextField fx:id="postalCode" prefHeight="27.0" prefWidth="177.0" promptText="Enter postal code"
                                   styleClass="textfield"/>
                     </children>
                  </VBox>
               </content>
            </TitledPane>
         </panes>
         <BorderPane.margin>
            <Insets left="20.0" right="20.0"/>
         </BorderPane.margin>
      </Accordion>
   </center>
</BorderPane>
