<?xml version="1.0" encoding="UTF-8"?>

<?import javafx.geometry.Insets?>
<?import javafx.scene.control.Button?>
<?import javafx.scene.control.Label?>
<?import javafx.scene.control.Spinner?>
<?import javafx.scene.control.TextField?>
<?import javafx.scene.layout.FlowPane?>
<?import javafx.scene.layout.VBox?>

<VBox prefHeight="438.0" prefWidth="410.0" stylesheets="@../../../Styles/globals.css" xmlns="http://javafx.com/javafx/23.0.1" xmlns:fx="http://javafx.com/fxml/1">
<!--      fx:controller="com.pcc.PatientCareCenter.Controllers.Admin.Patients.ClaimFormController">-->
   <children>
      <FlowPane alignment="CENTER" prefHeight="58.0" prefWidth="446.0">
         <children>
            <Label alignment="CENTER" styleClass="h1-p" text="Claim form" />
         </children>
      </FlowPane>
      <VBox prefHeight="290.0" prefWidth="470.0">
         <children>
            <Label styleClass="normal-text-p" text="Name">
               <VBox.margin>
                  <Insets bottom="5.0" top="10.0" />
               </VBox.margin>
            </Label>
            <TextField fx:id="name" promptText="Enter the name" styleClass="textfield" />
            <Label styleClass="normal-text-p" text="Paid amount">
               <VBox.margin>
                  <Insets bottom="5.0" top="10.0" />
               </VBox.margin>
            </Label>
            <Spinner fx:id="paidAmount" editable="true" prefHeight="25.0" prefWidth="157.0" styleClass="textfield" />
         </children>
         <VBox.margin>
            <Insets />
         </VBox.margin>
         <padding>
            <Insets bottom="10.0" left="10.0" right="10.0" top="10.0" />
         </padding>
      </VBox>
      <FlowPane alignment="CENTER_RIGHT" prefHeight="67.0" prefWidth="470.0">
         <children>
            <Button fx:id="printButton" mnemonicParsing="false" styleClass="button-primary" text="Print" />
         </children>
      </FlowPane>
   </children>
   <padding>
      <Insets bottom="10.0" left="10.0" right="10.0" top="10.0" />
   </padding>
</VBox>
