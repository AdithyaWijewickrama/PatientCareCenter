<?xml version="1.0" encoding="UTF-8"?>

<?import javafx.geometry.Insets?>
<?import javafx.scene.control.Button?>
<?import javafx.scene.control.Label?>
<?import javafx.scene.control.ListView?>
<?import javafx.scene.control.TextArea?>
<?import javafx.scene.control.TextField?>
<?import javafx.scene.layout.FlowPane?>
<?import javafx.scene.layout.HBox?>
<?import javafx.scene.layout.VBox?>

<VBox alignment="TOP_CENTER"
      maxHeight="-Infinity"
      maxWidth="-Infinity"
      minHeight="-Infinity"
      minWidth="-Infinity"
      prefHeight="574.0"
      prefWidth="543.0"
      stylesheets="@../../../Styles/globals.css"
      xmlns="http://javafx.com/javafx/23.0.1"
      xmlns:fx="http://javafx.com/fxml/1">
<!--      fx:controller="com.pcc.PatientCareCenter.Controllers.Admin.Patients.PrescriptionController">-->
    <children>
        <Label styleClass="h1-p" text="Prescription"/>
        <VBox prefHeight="366.0" prefWidth="385.0">
            <VBox.margin>
                <Insets bottom="5.0" left="5.0" right="5.0" top="5.0"/>
            </VBox.margin>
            <children>
                <Label styleClass="normal-text-p" text="Patient name">
                    <VBox.margin>
                        <Insets bottom="5.0" top="10.0"/>
                    </VBox.margin>
                </Label>
                <TextField fx:id="name" promptText="Enter the name" styleClass="textfield"/>
                <Label styleClass="normal-text-p" text="Description about medicine">
                    <VBox.margin>
                        <Insets bottom="5.0" top="10.0"/>
                    </VBox.margin>
                </Label>
                <ListView fx:id="descriptionList" prefHeight="141.0" prefWidth="385.0"/>
                <HBox prefHeight="36.0" prefWidth="385.0">
                    <children>
                        <Label text="Add a medicine">
                            <HBox.margin>
                                <Insets bottom="5.0" left="5.0" right="5.0" top="5.0"/>
                            </HBox.margin>
                        </Label>
                        <Button fx:id="addMedicine" mnemonicParsing="false" text="+"/>
                    </children>
                </HBox>
                <TextArea fx:id="description" prefHeight="106.0" prefWidth="385.0"
                          promptText="Enter description here..." styleClass="textfield"/>
            </children>
        </VBox>
        <VBox prefHeight="200.0" prefWidth="100.0">
            <children>
                <Label styleClass="normal-text-p" text="Description"/>
                <TextArea fx:id="descriptionOther" prefHeight="246.0" prefWidth="385.0"
                          promptText="Enter description here..." styleClass="textfield"/>
            </children>
            <VBox.margin>
                <Insets bottom="5.0" left="5.0" right="5.0" top="5.0"/>
            </VBox.margin>
        </VBox>
        <FlowPane alignment="CENTER_RIGHT" prefHeight="52.0" prefWidth="395.0">
            <children>
                <Button fx:id="printAndSend" mnemonicParsing="false" styleClass="button-primary"
                        text="Print &amp; Send">
                    <padding>
                        <Insets bottom="5.0" left="5.0" right="5.0" top="5.0"/>
                    </padding>
                    <FlowPane.margin>
                        <Insets right="10.0"/>
                    </FlowPane.margin>
                </Button>
                <Button fx:id="print" mnemonicParsing="false" styleClass="button-primary" text="Print prescription">
                    <padding>
                        <Insets bottom="5.0" left="5.0" right="5.0" top="5.0"/>
                    </padding>
                </Button>
            </children>
            <padding>
                <Insets bottom="5.0" left="5.0" right="5.0" top="5.0"/>
            </padding>
        </FlowPane>
    </children>
    <padding>
        <Insets bottom="10.0" left="10.0" right="10.0" top="10.0"/>
    </padding>
</VBox>
