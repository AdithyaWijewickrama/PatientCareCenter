<?xml version="1.0" encoding="UTF-8"?>

<?import javafx.geometry.Insets?>
<?import javafx.scene.control.Accordion?>
<?import javafx.scene.control.Button?>
<?import javafx.scene.control.CheckBox?>
<?import javafx.scene.control.TitledPane?>
<?import javafx.scene.layout.AnchorPane?>
<?import javafx.scene.layout.FlowPane?>
<?import javafx.scene.layout.VBox?>


<AnchorPane prefHeight="561.0" prefWidth="470.0" stylesheets="@../../../Styles/globals.css"
            xmlns="http://javafx.com/javafx/23.0.1" xmlns:fx="http://javafx.com/fxml/1">
<!--            fx:controller="com.pcc.PatientCareCenter.Controllers.Admin.Patients.SearchConfigController"-->
    <Accordion layoutX="14.0" layoutY="14.0" prefHeight="494.0" prefWidth="440.0">
      <panes>
          <TitledPane animated="false" prefHeight="489.0" prefWidth="440.0" text="Columns">
              <VBox>
                  <CheckBox fx:id="id" disable="true" mnemonicParsing="false" selected="true"
                            styleClass="normal-text-p" text="Patient Id">
                      <VBox.margin>
                          <Insets top="5.0"/>
                      </VBox.margin>
                  </CheckBox>
                  <CheckBox fx:id="name" disable="true" mnemonicParsing="false" selected="true"
                            styleClass="normal-text-p" text="Name">
                      <VBox.margin>
                          <Insets top="5.0"/>
                      </VBox.margin>
                  </CheckBox>
                  <CheckBox fx:id="dateOfBirth" mnemonicParsing="false" styleClass="normal-text-p"
                            text="Email or Number">
                      <VBox.margin>
                          <Insets top="5.0"/>
                      </VBox.margin>
                  </CheckBox>
                  <CheckBox fx:id="mobileNumber" mnemonicParsing="false" styleClass="normal-text-p"
                            text="Mobile number">
                      <VBox.margin>
                          <Insets top="5.0"/>
                      </VBox.margin>
                  </CheckBox>
                  <CheckBox fx:id="whatsappNumber" mnemonicParsing="false" styleClass="normal-text-p"
                            text="Whatsapp number">
                      <VBox.margin>
                          <Insets top="5.0"/>
                      </VBox.margin>
                  </CheckBox>
                  <CheckBox fx:id="address" mnemonicParsing="false" styleClass="normal-text-p" text="Address">
                      <VBox.margin>
                          <Insets top="5.0"/>
                      </VBox.margin>
                  </CheckBox>
                  <CheckBox fx:id="gender" mnemonicParsing="false" styleClass="normal-text-p" text="Gender">
                      <VBox.margin>
                          <Insets top="5.0"/>
                      </VBox.margin>
                  </CheckBox>
                  <CheckBox fx:id="maritalStatus" mnemonicParsing="false" styleClass="normal-text-p"
                            text="Marital status">
                      <VBox.margin>
                          <Insets top="5.0"/>
                      </VBox.margin>
                  </CheckBox>
                  <CheckBox fx:id="nationality" mnemonicParsing="false" styleClass="normal-text-p"
                            text="Nationality">
                      <VBox.margin>
                          <Insets top="5.0"/>
                      </VBox.margin>
                  </CheckBox>
                  <CheckBox fx:id="languagePreference" mnemonicParsing="false" styleClass="normal-text-p"
                            text="Language preference">
                      <VBox.margin>
                          <Insets top="5.0"/>
                      </VBox.margin>
                  </CheckBox>
                  <CheckBox fx:id="city" mnemonicParsing="false" styleClass="normal-text-p" text="City">
                      <VBox.margin>
                          <Insets top="5.0"/>
                      </VBox.margin>
                  </CheckBox>
              </VBox>
          </TitledPane>
      </panes>
    </Accordion>
    <FlowPane alignment="CENTER_RIGHT" layoutX="14.0" layoutY="508.0" prefHeight="49.0" prefWidth="440.0">
        <children>
          <Button fx:id="applyButton" mnemonicParsing="false" styleClass="button-primary" text="Apply"/>
        </children>
    </FlowPane>
</AnchorPane>
