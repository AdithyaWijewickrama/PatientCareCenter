<?xml version="1.0" encoding="UTF-8"?>

<?import javafx.geometry.Insets?>
<?import javafx.scene.control.Button?>
<?import javafx.scene.control.Label?>
<?import javafx.scene.control.TextField?>
<?import javafx.scene.layout.FlowPane?>
<?import javafx.scene.layout.VBox?>


<VBox prefHeight="431.0"
      prefWidth="450.0"
      stylesheets="@../../Styles/globals.css"
      xmlns="http://javafx.com/javafx/23.0.1"
      xmlns:fx="http://javafx.com/fxml/1">
<!--      fx:controller="com.pcc.PatientCareCenter.Controllers.Admin.ProfileController">-->
   <children>
      <Label styleClass="h1-p" text="Profile"/>
      <VBox prefHeight="279.0" prefWidth="430.0">
         <children>
            <Label styleClass="normal-text-p" text="Name">
               <VBox.margin>
                  <Insets bottom="5.0" top="10.0"/>
               </VBox.margin>
            </Label>
            <TextField fx:id="name" promptText="Enter the name of the doctor" styleClass="textfield"/>
            <Label styleClass="normal-text-p" text="Occupation">
               <VBox.margin>
                  <Insets bottom="5.0" top="10.0"/>
               </VBox.margin>
            </Label>
            <TextField fx:id="occupation" promptText="Enter the name of the doctor" styleClass="textfield"/>
         </children>
         <padding>
            <Insets bottom="10.0" left="10.0" right="10.0" top="10.0"/>
         </padding>
      </VBox>
      <FlowPane alignment="CENTER_RIGHT" prefHeight="86.0" prefWidth="430.0">
         <children>
            <Button fx:id="saveButton" mnemonicParsing="false" styleClass="button-primary" text="Save"/>
         </children>
      </FlowPane>
   </children>
   <padding>
      <Insets bottom="10.0" left="10.0" right="10.0" top="10.0"/>
   </padding>
</VBox>
