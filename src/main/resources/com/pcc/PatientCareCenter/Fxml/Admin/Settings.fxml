<?xml version="1.0" encoding="UTF-8"?>

<?import javafx.geometry.Insets?>
<?import javafx.scene.control.Accordion?>
<?import javafx.scene.control.Button?>
<?import javafx.scene.control.Label?>
<?import javafx.scene.control.PasswordField?>
<?import javafx.scene.control.TextField?>
<?import javafx.scene.control.TitledPane?>
<?import javafx.scene.layout.VBox?>
<?import javafx.scene.text.Text?>

<VBox prefHeight="630.0"
      prefWidth="522.0"
      stylesheets="@../../Styles/globals.css"
      xmlns="http://javafx.com/javafx/23.0.1"
      xmlns:fx="http://javafx.com/fxml/1">
<!--      fx:controller="com.pcc.PatientCareCenter.Controllers.Admin.SettingsController"-->
    <padding>
        <Insets bottom="10.0" left="10.0" right="10.0" top="10.0"/>
    </padding>
    <Label styleClass="h1-p" text="Settings"/>
    <VBox prefHeight="550.0" prefWidth="502.0">
        <padding>
            <Insets bottom="10.0" left="10.0" right="10.0" top="10.0"/>
        </padding>
        <Accordion>
            <panes>
                <TitledPane animated="false" text="User details">
                    <VBox prefHeight="200.0" prefWidth="100.0">
                        <padding>
                            <Insets bottom="10.0" left="10.0" right="10.0" top="10.0"/>
                        </padding>
                        <Text strokeType="OUTSIDE" strokeWidth="0.0" styleClass="normal-text-p"
                              text="Email">
                            <VBox.margin>
                                <Insets bottom="5.0" top="10.0"/>
                            </VBox.margin>
                        </Text>
                        <TextField fx:id="email" prefHeight="26.0" prefWidth="400.0"
                                   promptText="Enter email"
                                   styleClass="textfield">
                            <opaqueInsets>
                                <Insets/>
                            </opaqueInsets>
                        </TextField>
                        <Text strokeType="OUTSIDE" strokeWidth="0.0" styleClass="normal-text-p"
                              text="Current password">
                            <VBox.margin>
                                <Insets bottom="5.0" top="10.0"/>
                            </VBox.margin>
                        </Text>
                        <PasswordField fx:id="password" editable="false" prefHeight="26.0"
                                       prefWidth="400.0"
                                       promptText="Enter password" styleClass="textfield"/>
                        <Text strokeType="OUTSIDE" strokeWidth="0.0" styleClass="normal-text-p"
                              text="New password">
                            <VBox.margin>
                                <Insets bottom="5.0" top="10.0"/>
                            </VBox.margin>
                        </Text>
                        <PasswordField fx:id="newPassword" prefHeight="26.0" prefWidth="400.0"
                                       promptText="Enter new password" styleClass="textfield"/>
                        <Text strokeType="OUTSIDE" strokeWidth="0.0" styleClass="normal-text-p"
                              text="Confirm new password">
                            <VBox.margin>
                                <Insets bottom="5.0" top="10.0"/>
                            </VBox.margin>
                        </Text>
                        <PasswordField fx:id="confirmNewPassword" prefHeight="26.0" prefWidth="400.0"
                                       promptText="Confirm new password" styleClass="textfield"/>
                        <Button fx:id="saveUserDetailsButton" mnemonicParsing="false"
                                styleClass="button-primary"
                                text="Save">
                            <VBox.margin>
                                <Insets bottom="5.0" top="10.0"/>
                            </VBox.margin>
                        </Button>
                    </VBox>
                </TitledPane>
                <TitledPane animated="false" prefHeight="697.0" prefWidth="482.0"
                            text="Private practice details">
                    <VBox prefHeight="200.0" prefWidth="100.0">
                        <Text strokeType="OUTSIDE" strokeWidth="0.0" styleClass="normal-text-p"
                              text="PP Name">
                            <VBox.margin>
                                <Insets bottom="5.0" top="10.0"/>
                            </VBox.margin>
                        </Text>
                        <TextField fx:id="ppName" prefHeight="26.0" prefWidth="400.0"
                                   promptText="Enter pp name"
                                   styleClass="textfield"/>
                        <Text strokeType="OUTSIDE" strokeWidth="0.0" styleClass="normal-text-p"
                              text="PP Address">
                            <VBox.margin>
                                <Insets bottom="5.0" top="10.0"/>
                            </VBox.margin>
                        </Text>
                        <TextField fx:id="ppAddress" prefHeight="26.0" prefWidth="400.0"
                                   promptText="Enter pp address" styleClass="textfield"/>
                        <Text strokeType="OUTSIDE" strokeWidth="0.0" styleClass="normal-text-p"
                              text="PP Email">
                            <VBox.margin>
                                <Insets bottom="5.0" top="10.0"/>
                            </VBox.margin>
                        </Text>
                        <TextField fx:id="ppEmail" prefHeight="26.0" prefWidth="400.0"
                                   promptText="Enter pp email"
                                   styleClass="textfield"/>
                        <Text strokeType="OUTSIDE" strokeWidth="0.0" styleClass="normal-text-p"
                              text="PP Telephone">
                            <VBox.margin>
                                <Insets bottom="5.0" top="10.0"/>
                            </VBox.margin>
                        </Text>
                        <TextField fx:id="ppTelephone" layoutX="20.0" layoutY="177.0" prefHeight="26.0"
                                   prefWidth="400.0" promptText="Enter pp telephone"
                                   styleClass="textfield"/>
                        <Button fx:id="ppSaveButton" mnemonicParsing="false" styleClass="button-primary"
                                text="Save">
                            <VBox.margin>
                                <Insets top="10.0"/>
                            </VBox.margin>
                        </Button>
                    </VBox>
                </TitledPane>
                <TitledPane prefHeight="200.0" prefWidth="200.0" text="Database(POSTGRESQL)">
                    <VBox prefHeight="200.0" prefWidth="100.0">
                        <padding>
                            <Insets bottom="10.0" left="10.0" right="10.0" top="10.0"/>
                        </padding>
                        <Text strokeType="OUTSIDE" strokeWidth="0.0" styleClass="normal-text-p"
                              text="Postgres url">
                            <VBox.margin>
                                <Insets bottom="5.0" top="10.0"/>
                            </VBox.margin>
                        </Text>
                        <TextField fx:id="postgresUrl" editable="false" prefHeight="26.0"
                                       prefWidth="400.0"
                                       promptText="Enter url" styleClass="textfield"/>
                        <Text strokeType="OUTSIDE" strokeWidth="0.0" styleClass="normal-text-p"
                              text="Postgres username">
                            <VBox.margin>
                                <Insets bottom="5.0" top="10.0"/>
                            </VBox.margin>
                        </Text>
                        <TextField fx:id="postgresUsername" editable="false" prefHeight="26.0"
                                       prefWidth="400.0" promptText="Enter username"
                                       styleClass="textfield"/>
                        <Text strokeType="OUTSIDE" strokeWidth="0.0" styleClass="normal-text-p"
                              text="Postgres password">
                            <VBox.margin>
                                <Insets bottom="5.0" top="10.0"/>
                            </VBox.margin>
                        </Text>
                        <PasswordField fx:id="postgresPassword" prefHeight="26.0" prefWidth="400.0"
                                       promptText="Enter password" styleClass="textfield"/>
                        <Button fx:id="postgresSaveButton" mnemonicParsing="false"
                                styleClass="button-primary" text="Save">
                            <VBox.margin>
                                <Insets top="10.0"/>
                            </VBox.margin>
                        </Button>
                    </VBox>
                </TitledPane>
                <TitledPane animated="false" prefHeight="478.0" prefWidth="482.0" text="Server">
                    <VBox prefHeight="200.0" prefWidth="100.0">
                        <padding>
                            <Insets bottom="10.0" left="10.0" right="10.0" top="10.0"/>
                        </padding>
                        <Text strokeType="OUTSIDE" strokeWidth="0.0" styleClass="normal-text-p"
                              text="Webhook server">
                            <VBox.margin>
                                <Insets bottom="5.0" top="10.0"/>
                            </VBox.margin>
                        </Text>
                        <TextField fx:id="webhook" prefHeight="26.0" prefWidth="400.0"
                                   promptText="Enter webhook server url" styleClass="textfield">
                            <opaqueInsets>
                                <Insets/>
                            </opaqueInsets>
                        </TextField>
                        <Button fx:id="webhookButton" mnemonicParsing="false"
                                styleClass="button-primary"
                                text="Save">
                            <VBox.margin>
                                <Insets top="10.0"/>
                            </VBox.margin>
                        </Button>
                    </VBox>
                </TitledPane>
            </panes>
        </Accordion>
    </VBox>
</VBox>
