<?xml version="1.0" encoding="UTF-8"?>

<?import javafx.geometry.Insets?>
<?import javafx.scene.control.Accordion?>
<?import javafx.scene.control.Button?>
<?import javafx.scene.control.Label?>
<?import javafx.scene.control.PasswordField?>
<?import javafx.scene.control.TextField?>
<?import javafx.scene.control.TitledPane?>
<?import javafx.scene.layout.VBox?>
<?import javafx.scene.text.Text?>

<VBox prefHeight="630.0" prefWidth="522.0" stylesheets="@../../Styles/globals.css" xmlns="http://javafx.com/javafx/23.0.1" xmlns:fx="http://javafx.com/fxml/1">
<!--      fx:controller="com.pcc.PatientCareCenter.Controllers.Admin.SettingsController">-->
   <children>
      <Label styleClass="h1-p" text="Settings" />
      <VBox prefHeight="550.0" prefWidth="502.0">
         <padding>
            <Insets bottom="10.0" left="10.0" right="10.0" top="10.0" />
         </padding>
         <children>
            <Accordion>
               <panes>
                  <TitledPane animated="false" text="User details">
                     <content>
                        <VBox prefHeight="200.0" prefWidth="100.0">
                           <padding>
                              <Insets bottom="10.0" left="10.0" right="10.0" top="10.0" />
                           </padding>
                           <children>
                              <Text strokeType="OUTSIDE" strokeWidth="0.0" styleClass="normal-text-p" text="Email">
                                 <VBox.margin>
                                    <Insets bottom="5.0" top="10.0" />
                                 </VBox.margin>
                              </Text>
                              <TextField fx:id="email" prefHeight="26.0" prefWidth="400.0" promptText="Enter email" styleClass="textfield">
                                 <opaqueInsets>
                                    <Insets />
                                 </opaqueInsets>
                              </TextField>
                              <Text strokeType="OUTSIDE" strokeWidth="0.0" styleClass="normal-text-p" text="Current password">
                                 <VBox.margin>
                                    <Insets bottom="5.0" top="10.0" />
                                 </VBox.margin>
                              </Text>
                              <PasswordField fx:id="password" editable="false" prefHeight="26.0" prefWidth="400.0" promptText="Enter password" styleClass="textfield" />
                              <Text strokeType="OUTSIDE" strokeWidth="0.0" styleClass="normal-text-p" text="New password">
                                 <VBox.margin>
                                    <Insets bottom="5.0" top="10.0" />
                                 </VBox.margin>
                              </Text>
                              <PasswordField fx:id="newPassword" prefHeight="26.0" prefWidth="400.0" promptText="Enter new password" styleClass="textfield" />
                              <Text strokeType="OUTSIDE" strokeWidth="0.0" styleClass="normal-text-p" text="Confirm new password">
                                 <VBox.margin>
                                    <Insets bottom="5.0" top="10.0" />
                                 </VBox.margin>
                              </Text>
                              <PasswordField fx:id="confirmNewPassword" prefHeight="26.0" prefWidth="400.0" promptText="Confirm new password" styleClass="textfield" />
                              <Button fx:id="saveUserDetailsButton" mnemonicParsing="false" styleClass="button-primary" text="Save">
                                 <VBox.margin>
                                    <Insets bottom="5.0" top="10.0" />
                                 </VBox.margin>
                              </Button>
                           </children>
                        </VBox>
                     </content>
                  </TitledPane>
                  <TitledPane animated="false" prefHeight="697.0" prefWidth="482.0" text="Private practice details">
                     <content>
                        <VBox prefHeight="200.0" prefWidth="100.0">
                           <children>
                              <Text strokeType="OUTSIDE" strokeWidth="0.0" styleClass="normal-text-p" text="PP Name">
                                 <VBox.margin>
                                    <Insets bottom="5.0" top="10.0" />
                                 </VBox.margin>
                              </Text>
                              <PasswordField fx:id="ppName" prefHeight="26.0" prefWidth="400.0" promptText="Enter pp name" styleClass="textfield" />
                              <Text strokeType="OUTSIDE" strokeWidth="0.0" styleClass="normal-text-p" text="PP Address">
                                 <VBox.margin>
                                    <Insets bottom="5.0" top="10.0" />
                                 </VBox.margin>
                              </Text>
                              <PasswordField fx:id="ppAddress" prefHeight="26.0" prefWidth="400.0" promptText="Enter pp address" styleClass="textfield" />
                              <Text strokeType="OUTSIDE" strokeWidth="0.0" styleClass="normal-text-p" text="PP Email">
                                 <VBox.margin>
                                    <Insets bottom="5.0" top="10.0" />
                                 </VBox.margin>
                              </Text>
                              <PasswordField fx:id="ppEmail" prefHeight="26.0" prefWidth="400.0" promptText="Enter pp email" styleClass="textfield" />
                              <Text strokeType="OUTSIDE" strokeWidth="0.0" styleClass="normal-text-p" text="PP Telephone">
                                 <VBox.margin>
                                    <Insets bottom="5.0" top="10.0" />
                                 </VBox.margin>
                              </Text>
                              <PasswordField fx:id="ppTelephone" layoutX="20.0" layoutY="177.0" prefHeight="26.0" prefWidth="400.0" promptText="Enter pp telephone" styleClass="textfield" />
                              <Button fx:id="ppSaveButton" mnemonicParsing="false" styleClass="button-primary" text="Save">
                                 <VBox.margin>
                                    <Insets top="10.0" />
                                 </VBox.margin>
                              </Button>
                           </children>
                        </VBox>
                     </content>
                  </TitledPane>
               </panes>
            </Accordion>
         </children>
      </VBox>
   </children>
   <padding>
      <Insets bottom="10.0" left="10.0" right="10.0" top="10.0" />
   </padding>
</VBox>
